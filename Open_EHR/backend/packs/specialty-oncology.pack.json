          },
          {
            "code": "399068003",
            "display": "Malignant neoplasm of prostate",
            "active": true,
            "system": "http://snomed.info/sct"
          }
        ]
      }
    },
    {
      "kind": "cohort",
      "key": "oncology-registry",
      "payload": {
        "name": "Cancer registry",
        "description": "Persons with a malignant neoplastic disease diagnosis \u2014 the cancer registry cohort (regimen adherence measures are Phase 9 measure configs over this population).",
        "smallCellThreshold": 5,
        "ageBands": [
          [
            0,
            17,
            "0-17"
          ],
          [
            18,
            44,
            "18-44"
          ],
          [
            45,
            64,
            "45-64"
          ],
          [
            65,
            74,
            "65-74"
          ],
          [
            75,
            null,
            "75+"
          ]
        ],
        "conditionCodes": [
          {
            "system": "http://snomed.info/sct",
            "code": "363346000"
          },
          {
            "system": "http://snomed.info/sct",
            "code": "254837009"
          },
          {
            "system": "http://snomed.info/sct",
            "code": "363358000"
          },
          {
            "system": "http://snomed.info/sct",
            "code": "363406005"
          },
          {
            "system": "http://snomed.info/sct",
            "code": "399068003"
          }
        ]
      }
    }
  ]
}
