{
  "name": "specialty-oncology",
  "version": "1.1.0",
  "description": "Specialty operations pack \u2014 cancer (roadmap \u00a74). Diagnosis/staging charting (TNM + ECOG), chemotherapy REGIMENS as cycle/day order-set data (regimen -> cycle -> day: the cycle/day structure rides each order-set item's note onto the placed order), antiemetic/supportive-care bundles, toxicity flowsheets (CTCAE-style grades), tumour-board documentation with a trial-screening flag, and the cancer registry cohort. All content is Studio configuration applied at pack enable; the regimen adherence measures a site wants are Phase 9 measure configs over the same data. Phase 15 regimen depth: a named-regimen library (FOLFOX and AC order sets with the cycle/day structure documented in each set), a treatment-plan form (regimen, cycle number, intent, BSA), a dedicated TNM staging form, an oncology assessment form, a two-clinician chemotherapy-verification form, and chemotherapy safety through the generic pharmacy medication-monitoring hook \u2014 the pack publishes the formulary extension (chemotherapy agents incl. methotrexate) and a FLAG level-monitoring rule for methotrexate, a narrow-therapeutic-index agent (machinery: app.pharmacy.medication_monitoring_check; rules: this pack's terminology append).",
  "modules": [
    {
      "id": "oncology-workspace",
      "name": "Oncology workspace",
      "enabled": false
    },
    {
      "id": "oncology-registry",
      "name": "Cancer registry",
      "enabled": false
    }
  ],
  "forms": [
    {
      "id": "oncology-intake",
      "name": "Oncology Intake & Staging",
      "fields": [
        "primary-site",
        "histology",
        "stage",
        "tnm-t",
        "tnm-n",
        "tnm-m",
        "ecog",
        "treatment-intent",
        "allergies-reviewed"
      ]
    },
    {
      "id": "oncology-toxicity",
      "name": "Oncology Toxicity Flowsheet",
      "fields": [
        "cycle-number",
        "nausea-grade",
        "fatigue-grade",
        "neuropathy-grade",
        "pain-score",
        "weight-kg"
      ]
    },
    {
      "id": "oncology-tumour-board",
      "name": "Tumour Board Review",
      "fields": [
        "case-summary",
        "board-recommendation",
        "trial-screening-flag",
        "survivorship-plan"
      ]
    },
    {
      "id": "oncology-treatment-plan",
      "name": "Oncology Treatment Plan",
      "fields": [
        "regimen",
        "cycle-number",
        "intent",
        "bsa-m2",
        "planned-cycles",
        "start-date"
      ]
    },
    {
      "id": "oncology-staging",
      "name": "TNM Staging",
      "fields": [
        "primary-site",
        "tnm-t",
        "tnm-n",
        "tnm-m",
        "stage-group",
        "staging-basis"
      ]
    },
    {
      "id": "oncology-assessment",
      "name": "Oncology Assessment",
      "fields": [
        "assessment-summary",
        "ecog",
        "pain-score",
        "weight-kg",
        "allergies-reviewed",
        "prior-therapy"
      ]
    },
    {
      "id": "oncology-chemo-verification",
      "name": "Chemotherapy Verification (two-clinician)",
      "fields": [
        "regimen",
        "cycle-number",
        "patient-identity-verified",
        "dose-and-bsa-verified",
        "first-clinician",
        "second-clinician",
        "verification-outcome"
      ]
    }
  ],
