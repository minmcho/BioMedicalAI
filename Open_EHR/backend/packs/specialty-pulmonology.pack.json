{
  "name": "specialty-pulmonology",
  "version": "1.1.0",
  "description": "Specialty operations pack \u2014 pulmonology & lung (roadmap \u00a74). Spirometry/PFT orders with FEV1/FVC results landing on the PFT flowsheet, COPD/asthma action plans, sleep-study pathway, bronchoscopy procedure terminology; registry: COPD + asthma cohort (the lung-nodule tracking registry rides this same cohort mechanism with nodule codes at sites that publish them). Phase 15 depth (BD-03): MEDICATION MONITORING in the psychiatry pattern \u2014 the pack republishes the formulary with theophylline and the monitoring rule the generic pharmacy gate evaluates: theophylline dispensing BLOCKS without a level <= 20 mg/L within 90 days (narrow therapeutic index).",
  "modules": [
    {
      "id": "pulmonology-workspace",
      "name": "Pulmonology workspace",
      "enabled": false
    },
    {
      "id": "pulmonology-registry",
      "name": "Lung registry",
      "enabled": false
    }
  ],
  "forms": [
    {
      "id": "pulmonology-intake",
      "name": "Pulmonology Intake",
      "fields": [
        "mmrc-grade",
        "pack-years",
        "exacerbations-last-year",
        "primary-inhaler"
      ]
    },
    {
      "id": "pulmonology-pft",
      "name": "PFT Flowsheet",
      "fields": [
        "fev1-litres",
        "fvc-litres",
        "fev1-fvc-ratio",
        "dlco"
      ]
    },
    {
      "id": "pulmonology-action-plan",
      "name": "COPD/Asthma Action Plan",
      "fields": [
        "usual-state",
        "rescue-instructions",
        "escalation-instructions"
      ]
    }
  ],
  "api_endpoints": [],
  "configuration": [
    {
      "kind": "orderset",
      "key": "pulmonology-copd-exacerbation",
      "payload": {
        "name": "Pulmonology \u2014 COPD exacerbation",
        "description": "Exacerbation set: bronchodilator, oxygen titration, steroid course (synthetic demo), spirometry when stable.",
        "orders": [
          {
            "type": "medication",
            "code": "245314",
            "display": "Albuterol 0.09 MG/ACTUAT Metered Dose Inhaler"
          },
          {
            "type": "nursing",
            "code": "oxygen-titration",
            "display": "Oxygen titration to SpO2 88-92%"
          },
          {
            "type": "medication",
            "code": "prednisone-demo",
            "display": "Prednisone course (synthetic demo)"
          },
          {
            "type": "procedure",
            "code": "spirometry",
            "display": "Spirometry with bronchodilator response"
          }
        ]
      }
    },
    {
      "kind": "orderset",
      "key": "pulmonology-sleep-study",
      "payload": {
        "name": "Pulmonology \u2014 sleep study pathway",
        "description": "Sleep-study pathway: polysomnography order and pre-study instructions (CPAP titration follows the study report).",
        "orders": [
          {
            "type": "procedure",
            "code": "polysomnography",
            "display": "Polysomnography (sleep study)"
          },
          {
            "type": "nursing",
            "code": "sleep-study-prep",
            "display": "Sleep-study preparation instructions given"
          }
        ]
      }
    },
    {
      "kind": "form",
      "key": "pulmonology-intake",
      "payload": {
        "resourceType": "Questionnaire",
        "title": "Pulmonology intake",
        "item": [
          {
            "linkId": "mmrc-grade",
            "text": "mMRC dyspnoea grade (0-4)",
            "type": "integer",
            "required": true
          },
          {
            "linkId": "pack-years",
            "text": "Smoking pack-years",
            "type": "decimal",
            "required": false
          },
          {
            "linkId": "exacerbations-last-year",
            "text": "Exacerbations in the last year",
            "type": "integer",
            "required": false
          },
          {
            "linkId": "primary-inhaler",
            "text": "Primary inhaler",
            "type": "choice",
            "required": false,
            "answerOption": [
              {
                "valueCoding": {
                  "code": "none",
                  "display": "None"
                }
              },
              {
                "valueCoding": {
                  "code": "saba",
                  "display": "SABA"
                }
              },
              {
                "valueCoding": {
                  "code": "ics-laba",
                  "display": "ICS/LABA"
                }
              },
              {
                "valueCoding": {
                  "code": "lama",
                  "display": "LAMA"
                }
              },
              {
                "valueCoding": {
                  "code": "triple",
                  "display": "Triple therapy"
                }
              }
            ]
          },
          {
            "linkId": "inhaler-technique-checked",
            "text": "Inhaler technique checked",
            "type": "boolean",
            "required": false
          }
        ]
      }
    },
    {
      "kind": "form",
      "key": "pulmonology-pft",
      "payload": {
        "resourceType": "Questionnaire",
        "title": "Pulmonary function flowsheet",
        "item": [
          {
            "linkId": "fev1-litres",
            "text": "FEV1 (L)",
            "type": "decimal",
            "required": true
          },
          {
            "linkId": "fvc-litres",
            "text": "FVC (L)",
            "type": "decimal",
            "required": true
          },
          {
            "linkId": "fev1-fvc-ratio",
            "text": "FEV1/FVC ratio",
            "type": "decimal",
            "required": false
          },
          {
            "linkId": "dlco",
            "text": "DLCO (% predicted)",
            "type": "decimal",
            "required": false
          },
          {
            "linkId": "fev1-pct-predicted",
            "text": "FEV1 (% predicted)",
            "type": "decimal",
            "required": false
          },
          {
            "linkId": "bronchodilator-response",
            "text": "Significant bronchodilator response",
            "type": "boolean",
            "required": false
          }
        ]
      }
    },
    {
      "kind": "form",
      "key": "pulmonology-action-plan",
      "payload": {
        "resourceType": "Questionnaire",
        "title": "COPD / asthma action plan",
        "item": [
          {
            "linkId": "usual-state",
            "text": "Usual state",
            "type": "choice",
            "required": true,
            "answerOption": [
              {
                "valueCoding": {
                  "code": "stable",
                  "display": "Stable"
                }
              },
              {
                "valueCoding": {
                  "code": "recovering",
                  "display": "Recovering"
                }
              }
            ]
          },
          {
            "linkId": "rescue-instructions",
            "text": "Rescue (yellow zone) instructions",
            "type": "text",
            "required": true
          },
          {
            "linkId": "escalation-instructions",
            "text": "Escalation (red zone) instructions",
            "type": "text",
            "required": false
          }
        ]
      }
    },
