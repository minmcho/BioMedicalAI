{
  "name": "specialty-paediatrics",
  "version": "1.1.0",
  "description": "Specialty operations pack — paediatrics (Phase 15, BD-08; Phase 17 closes the BD-08 residual). Age-banded vitals flowsheet + growth/development assessment forms, a paediatric chronic-care registry cohort, and paediatric capacity: the pack republishes terminology/locations in full (the Phase 5 profile-pack configuration pattern) with a Paediatric Unit and four paediatric beds appended, so the census shows paediatric beds as a distinct unit class when the pack is enabled. SAFETY — stated precisely: Phase 15 could express ONLY lab-presence / lab-range / lab-age rules per medication code, so weight-based (mg/kg) dose checking was NOT expressible and was not claimed. Phase 17 extends the pharmacy monitoring vocabulary with a weight-based rule type (dose-per-kg bounds per age band, evaluated against the patient's recorded weight and birthDate), and this pack now publishes mg/kg rules as governed config: paracetamol dispensing BLOCKS on a dose outside 10–15 mg/kg/dose or 60 mg/kg/day for the patient's age band, and BLOCKS as cannot-evaluate when no weight is recorded. The lab-gated gentamicin rule (trough <= 2.0 mg/L + creatinine, each within 7 days) is retained in the psychiatry pattern.",
  "modules": [
    {
      "id": "paediatrics-workspace",
      "name": "Paediatrics workspace",
      "enabled": false
    },
    {
      "id": "paediatrics-registry",
      "name": "Paediatric registry",
      "enabled": false
    }
  ],
  "forms": [
    {
      "id": "paeds-vitals-flowsheet",
      "name": "Paediatric Vitals Flowsheet (age-banded)",
      "fields": [
        "age-band",
        "heart-rate",
        "respiratory-rate",
        "spo2",
        "temperature-c",
        "pain-scale",
        "pain-score"
      ]
    },
    {
      "id": "paeds-growth-development",
      "name": "Growth & Development Assessment",
      "fields": [
        "weight-kg",
        "height-cm",
        "head-circumference-cm",
        "weight-centile",
        "developmental-milestones",
        "immunisations-up-to-date",
        "safeguarding-concerns"
      ]
    }
  ],
