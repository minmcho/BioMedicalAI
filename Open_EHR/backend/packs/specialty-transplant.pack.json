    {
      "kind": "terminology",
      "key": "medication-monitoring",
      "payload": {
        "name": "Medication monitoring rules (high-risk medications) + transplant tacrolimus rule (specialty-transplant pack)",
        "system": "urn:opencare:medication-monitoring",
        "concepts": [
          {
            "code": "tacrolimus",
            "display": "Tacrolimus \u2014 trough + renal gating rule",
            "active": true
          }
        ],
        "rules": [
          {
            "medicationCode": "tacrolimus",
            "medicationDisplay": "Tacrolimus",
            "action": "block",
            "requiredLabs": [
              {
                "code": "77347-1",
                "display": "Tacrolimus trough level",
                "maxValue": 20.0,
                "maxAgeDays": 14
              },
              {
                "code": "2160-0",
                "display": "Serum creatinine",
                "maxAgeDays": 14
              },
              {
                "code": "2823-3",
                "display": "Serum potassium",
                "maxValue": 5.5,
                "maxAgeDays": 14
              }
            ]
          }
        ]
      }
    },
