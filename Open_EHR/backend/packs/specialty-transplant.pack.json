{
  "name": "specialty-transplant",
  "version": "1.0.0",
  "description": "Specialty operations pack \u2014 solid-organ transplant (Phase 15, BD-05). Waitlist/registry cohort, donor\u2013recipient linkage as a governed form + published terminology, and IMMUNOSUPPRESSION MONITORING in the psychiatry clozapine pattern: the pack republishes the formulary (tacrolimus, mycophenolate) and the medication-monitoring rules the generic pharmacy gate evaluates \u2014 tacrolimus dispensing BLOCKS without a trough level <= 20 ng/mL, a creatinine and a potassium <= 5.5 mmol/L, each within 14 days (narrow therapeutic index + nephrotoxicity watch). Donor records are synthetic linkage data only; no external organ-procurement integration is claimed.",
  "modules": [
    {
      "id": "transplant-workspace",
      "name": "Transplant workspace",
      "enabled": false
    },
    {
      "id": "transplant-registry",
      "name": "Transplant waitlist registry",
      "enabled": false
    }
  ],
  "forms": [
    {
      "id": "transplant-assessment",
      "name": "Transplant Assessment",
      "fields": [
        "organ",
        "transplant-date",
        "graft-function",
        "rejection-signs",
        "infection-screen",
        "adherence"
      ]
    },
    {
      "id": "transplant-donor-linkage",
      "name": "Donor\u2013Recipient Linkage",
      "fields": [
        "donor-type",
        "donor-reference",
        "organ",
        "donor-relationship",
        "crossmatch-result",
        "consent-confirmed",
        "linkage-verified-by"
      ]
    }
  ],
  "api_endpoints": [],
  "configuration": [
