            "type": "medication",
            "code": "tacrolimus",
            "display": "Tacrolimus 1 MG Oral Capsule"
          },
          {
            "type": "medication",
            "code": "mycophenolate",
            "display": "Mycophenolate mofetil 250 MG Oral Capsule"
          },
          {
            "type": "consult",
            "code": "transplant-review",
            "display": "Transplant team review \u2014 post-operative",
            "performerRole": "clinician"
          },
          {
            "type": "nursing",
            "code": "graft-observations",
            "display": "Graft observations every 4 hours"
          }
        ]
