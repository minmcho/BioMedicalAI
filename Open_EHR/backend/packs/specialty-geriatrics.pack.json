    {
      "kind": "rule",
      "key": "geriatrics-nitrofurantoin-renal-review",
      "payload": {
        "name": "Geriatric prescribing review \u2014 nitrofurantoin at low CrCl",
        "description": "Beers-pattern safety rule: a pharmacist verifying nitrofurantoin for a patient whose screened creatinine clearance is below 30 mL/min opens a geriatric prescribing-review Task for the pharmacy team.",
        "event": "pharmacy.dur.screened",
        "condition": {
          "all": [
            {
              "signal": "medication_code",
              "op": "eq",
              "value": "nitrofurantoin"
            },
            {
              "signal": "crcl_ml_min",
              "op": "lt",
              "value": 30
            }
          ]
        },
        "action": {
          "type": "create_task",
          "params": {
            "title": "Geriatric prescribing review \u2014 nitrofurantoin with CrCl < 30 mL/min",
            "ownerRole": "pharmacist"
          }
        },
        "enabled": true
      }
    },
    {
      "kind": "orderset",
      "key": "geriatrics-deprescribing-review",
      "payload": {
        "name": "Geriatrics \u2014 deprescribing review",
        "description": "Polypharmacy review bundle: pharmacist medication review, falls-risk nursing assessment, anticholinergic-burden screen.",
        "orders": [
          {
            "type": "consult",
            "code": "pharmacist-medication-review",
            "display": "Pharmacist medication review \u2014 deprescribing",
            "performerRole": "clinician"
          },
          {
            "type": "nursing",
            "code": "falls-risk-assessment",
            "display": "Falls-risk assessment (Morse-pattern)"
          },
          {
            "type": "nursing",
            "code": "anticholinergic-burden-screen",
            "display": "Anticholinergic burden screen"
          }
        ]
      }
    },
    {
      "kind": "form",
      "key": "geriatrics-falls-flowsheet",
      "payload": {
        "resourceType": "Questionnaire",
        "title": "Falls assessment flowsheet",
        "item": [
          {
            "linkId": "timed-up-and-go-seconds",
            "text": "Timed Up and Go (seconds)",
            "type": "decimal",
            "required": true
          },
          {
            "linkId": "orthostatic-systolic-drop",
            "text": "Orthostatic systolic drop (mmHg)",
            "type": "integer",
            "required": false
          },
          {
            "linkId": "assistive-device",
            "text": "Assistive device",
            "type": "choice",
            "required": false,
            "answerOption": [
              {
                "valueCoding": {
                  "code": "none",
                  "display": "None"
                }
              },
              {
                "valueCoding": {
                  "code": "stick",
                  "display": "Walking stick"
                }
              },
              {
                "valueCoding": {
                  "code": "frame",
                  "display": "Frame / walker"
                }
              },
              {
                "valueCoding": {
                  "code": "wheelchair",
                  "display": "Wheelchair"
                }
              }
            ]
          },
          {
            "linkId": "environmental-hazards",
            "text": "Environmental hazards identified",
            "type": "boolean",
            "required": false
          },
          {
            "linkId": "interventions",
            "text": "Interventions put in place",
            "type": "text",
            "required": false
          }
        ]
      }
    }
  ]
}
