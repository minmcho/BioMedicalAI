{
  "name": "specialty-cardiology",
  "version": "1.1.0",
  "description": "Specialty operations pack \u2014 cardiology (roadmap \u00a74). Chest-pain/ACS pathway order set (timed troponin protocol carried on the pathway form), heart-failure clinic order set + GDMT flowsheet, HEART-score risk form, structured echocardiography report form, device-clinic terminology; registry: heart-failure + post-MI cohort. Timeliness measures (door-to-balloon style) are Phase 9 measure configs over ADT/order timestamps. Phase 15 depth (BD-03): MEDICATION MONITORING in the psychiatry pattern \u2014 the pack republishes the formulary with digoxin and the medication-monitoring rules the generic pharmacy gate evaluates: digoxin dispensing BLOCKS without a potassium in 3.5\u20135.5 mmol/L within 30 days and a digoxin level <= 2.0 ng/mL within 90 days (hypokalaemia potentiates digoxin toxicity; the level caps the therapeutic range).",
  "modules": [
    {
      "id": "cardiology-workspace",
      "name": "Cardiology workspace",
      "enabled": false
    },
    {
      "id": "cardiology-registry",
      "name": "Cardiology registry",
      "enabled": false
    }
  ],
  "forms": [
    {
      "id": "cardiology-intake",
      "name": "Cardiology Intake",
      "fields": [
        "pain-onset",
        "pain-character",
        "radiation",
        "prior-mi",
        "device-type"
      ]
    },
    {
      "id": "cardiology-risk-score",
      "name": "HEART Score",
      "fields": [
        "heart-history",
        "heart-ecg",
        "heart-age",
        "heart-risk-factors",
        "heart-troponin"
      ]
    },
    {
      "id": "cardiology-echo",
      "name": "Echocardiogram Report",
      "fields": [
        "ejection-fraction",
        "wall-motion",
        "valve-findings"
      ]
    },
    {
      "id": "cardiology-hf-flowsheet",
      "name": "Heart Failure Flowsheet",
      "fields": [
        "weight-kg",
        "breathlessness",
        "oedema-grade",
        "fluid-intake-ml"
      ]
    }
  ],
  "api_endpoints": [],
  "configuration": [
    {
      "kind": "orderset",
      "key": "cardiology-acs-pathway",
      "payload": {
        "name": "Cardiology \u2014 chest pain / ACS pathway",
        "description": "ACS pathway: ECG, antiplatelet + statin loading, cardiac monitoring, cardiology consult. Troponin timing (0h/2h) is a laboratory protocol \u2014 the timed draws are placed in the LIS; the pathway form records the protocol times.",
        "orders": [
          {
            "type": "procedure",
            "code": "93005",
            "display": "Electrocardiogram (12-lead)"
          },
          {
            "type": "medication",
            "code": "1191",
            "display": "Aspirin 325 MG Oral Tablet (synthetic demo)",
            "note": "Chewed loading dose per ACS pathway"
          },
          {
            "type": "medication",
            "code": "1044910",
            "display": "Atorvastatin 20 MG Oral Tablet"
          },
          {
            "type": "nursing",
            "code": "cardiac-monitoring",
            "display": "Continuous cardiac monitoring"
          },
          {
            "type": "consult",
            "code": "cardiology-consult",
            "display": "Cardiology consult \u2014 ACS pathway",
            "performerRole": "clinician"
          }
        ]
      }
    },
    {
      "kind": "orderset",
      "key": "cardiology-hf-clinic",
      "payload": {
        "name": "Cardiology \u2014 heart failure clinic",
        "description": "HF clinic set: GDMT titration, daily weights, low-sodium diet education.",
        "orders": [
          {
            "type": "medication",
            "code": "1049221",
            "display": "Lisinopril 10 MG Oral Tablet"
          },
          {
            "type": "nursing",
            "code": "daily-weights",
            "display": "Daily weights, same scale, charted on HF flowsheet"
          },
          {
            "type": "diet",
            "code": "low-sodium-diet",
            "display": "Low-sodium diet education"
          }
        ]
      }
    },
