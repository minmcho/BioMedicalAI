          }
        }
      }
    },
    {
      "key": "lab-order-flow-poct",
      "kind": "workflow",
      "payload": {
        "governedStates": [
          "resulted",
          "released"
        ],
        "specimenStates": [
          "collected",
          "received",
          "in-process",
          "resulted",
          "released",
          "rejected"
        ],
        "states": [
          "cancelled",
          "collected",
          "in-process",
          "ordered",
          "received",
          "rejected",
          "released",
          "resulted"
        ],
        "transitions": [
          {
            "from": "ordered",
            "to": "collected"
          },
          {
            "from": "ordered",
            "to": "cancelled"
          },
          {
            "from": "collected",
            "to": "received"
          },
          {
            "from": "collected",
            "to": "rejected"
          },
          {
            "from": "received",
            "to": "in-process"
          },
          {
            "from": "received",
            "to": "rejected"
          },
          {
            "from": "in-process",
            "to": "resulted"
          },
          {
            "from": "in-process",
            "to": "rejected"
          },
          {
            "from": "resulted",
            "to": "released"
          }
        ]
      }
    },
    {
      "key": "default",
      "kind": "branding",
      "payload": {
        "orgName": "{{orgName}}",
        "portalTitle": "My results",
        "primaryColor": "#0b6e4f"
