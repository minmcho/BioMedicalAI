    {
      "kind": "cohort",
      "key": "rehab-outcomes-registry",
      "payload": {
        "name": "Rehabilitation outcomes registry",
        "description": "Persons admitted for rehabilitation after stroke, spinal cord injury or brain injury \u2014 functional gain and length-of-stay outcomes run over this cohort.",
        "smallCellThreshold": 5,
        "ageBands": [
          [
            0,
            17,
            "0-17"
          ],
          [
            18,
