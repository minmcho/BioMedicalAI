# Base URL of the OpenCare backend API (browser-reachable).
VITE_API_BASE=http://localhost:8000
# Auth mode shown by the sign-in screen: "dev" (seeded dev tokens) or "oidc".
# In oidc mode the web app does NOT run a fake SSO flow — it tells the user
# sign-in happens through the configured identity provider (Keycloak) and
# the API must be called with a token issued there.
VITE_AUTH_MODE=dev
